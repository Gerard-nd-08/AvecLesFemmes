{% extends 'base.html.twig' %}

{% block title %}Exercice index{% endblock %}

{% block body %}
    <h1>Exercice index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>DateDebut</th>
                <th>DateFin</th>
                <th>DateLimitePrets</th>
                <th>DateRetribution</th>
                <th>Statut</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for exercice in exercices %}
            <tr>
                <td>{{ exercice.id }}</td>
                <td>{{ exercice.dateDebut ? exercice.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ exercice.dateFin ? exercice.dateFin|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ exercice.dateLimitePrets ? exercice.dateLimitePrets|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ exercice.dateRetribution ? exercice.dateRetribution|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ exercice.statut }}</td>
                <td>
                    <a href="{{ path('app_exercice_show', {'id': exercice.id}) }}">show</a>
                    <a href="{{ path('app_exercice_edit', {'id': exercice.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_exercice_new') }}">Create new</a>
{% endblock %}
